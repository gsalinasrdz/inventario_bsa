APP_NAME="Inventario Grupo HLS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://inventario.grupohls.mx
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Base de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=grupohls_inventario
DB_USERNAME=grupohls_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sanctum SPA Auth
SANCTUM_STATEFUL_DOMAINS=inventario.grupohls.mx,localhost:5173

# Sesiones
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_DOMAIN=.grupohls.mx
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# Caché (database para shared hosting, sin Redis)
CACHE_STORE=database
CACHE_PREFIX=hls_

# Colas
QUEUE_CONNECTION=database

# Correo
MAIL_MAILER=smtp
MAIL_HOST=mail.grupohls.mx
MAIL_PORT=587
MAIL_USERNAME=sistema@grupohls.mx
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sistema@grupohls.mx
MAIL_FROM_NAME="Sistema HLS"

# Archivos
FILESYSTEM_DISK=local
MAX_UPLOAD_SIZE_MB=5

# CORS
FRONTEND_URL=https://inventario.grupohls.mx

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
LOCKOUT_DURATION_MINUTES=30

# Logs
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAYS=30

# Telescope (SOLO desarrollo)
TELESCOPE_ENABLED=false

# Activity Log
ACTIVITY_LOGGER_ENABLED=true

# Imágenes
IMAGE_MAX_WIDTH=800
IMAGE_MAX_HEIGHT=800
IMAGE_QUALITY=85

# Negocio
IVA_PORCENTAJE=16
MONEDA=MXN
EMPRESA_NOMBRE="Grupo HLS"
EMPRESA_RFC=
